# Copy to .env and replace every placeholder. Never commit .env or real values.
DATABASE_URL=<postgresql+psycopg-connection-url>
API_BASE_URL=<https-api-base-url-without-trailing-path>
# Auth for the upload API: either a fixed token ...
API_TOKEN=<catalog-api-bearer-token>
# ... and/or a Cognito service account that is signed in automatically. With both set, API_TOKEN is tried first and
# the login is the backup if the token has expired:
# COGNITO_REGION=eu-west-2
# COGNITO_CLIENT_ID=<app-client-id>
# COGNITO_USERNAME=<service-account-username>
# COGNITO_PASSWORD=<service-account-password>
# COGNITO_CLIENT_SECRET=<only-if-the-app-client-has-a-secret>
# COGNITO_TOKEN_USE=access
OPENAI_API_KEY=<openai-api-key>
# Required, no model defaults. Supported: gpt-4o-2024-08-06, gpt-5.4-mini (chosen), gpt-5.4-nano
OPENAI_TEXT_MODEL=<supported-text-model>
# Any gpt-image-* model ID. Chosen after comparison: gpt-image-2.6-flare (gpt-image-1 is closed)
OPENAI_IMAGE_MODEL=<supported-image-model>
# low, medium, high, auto; default if omitted: medium
OPENAI_IMAGE_QUALITY=<supported-quality>
# Only 1024x1024 in this MVP; default if omitted: 1024x1024
OPENAI_IMAGE_SIZE=<square-image-size>
# Private local storage directory; default if omitted: artifacts
ARTIFACT_DIR=<private-artifact-directory>
# Integer > 180; default if omitted: 300
LEASE_SECONDS=<lease-duration-in-seconds>
# Optional image provider: openai (default) or gemini. Text descriptions always use OpenAI.
# IMAGE_PROVIDER=gemini
# GEMINI_API_KEY=<gemini-api-key>
# GEMINI_IMAGE_MODEL=gemini-3.1-flash-image
# Optional: also save a readable copy of each final JPEG here (e.g. local_images). Private; gitignored.
# LOCAL_IMAGE_DIR=local_images
# Optional: local cost ledger CSV; default <ARTIFACT_DIR>/cost_log.csv
# COST_LOG_PATH=artifacts/cost_log.csv
# Optional: debug, info (default), warning or error. The --log-level option overrides it.
# LOG_LEVEL=info
# Optional: stay under your OpenAI rate limits. Requests per minute; unset or 0 = no pacing.
# OPENAI_IMAGE_RPM=8
# OPENAI_TEXT_RPM=20
