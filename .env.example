# Copy to .env and replace every placeholder. Never commit .env or real values.
DATABASE_URL=<postgresql+psycopg-connection-url>
API_BASE_URL=<https-api-base-url-without-trailing-path>
API_TOKEN=<catalog-api-bearer-token>
OPENAI_API_KEY=<openai-api-key>
# Required, no model defaults. Supported: gpt-4o-2024-08-06
OPENAI_TEXT_MODEL=<supported-text-model>
# Supported: gpt-image-1, gpt-image-1-mini, gpt-image-1.5
OPENAI_IMAGE_MODEL=<supported-image-model>
# low, medium, high, auto; default if omitted: medium
OPENAI_IMAGE_QUALITY=<supported-quality>
# Only 1024x1024 in this MVP; default if omitted: 1024x1024
OPENAI_IMAGE_SIZE=<square-image-size>
# Private local storage directory; default if omitted: artifacts
ARTIFACT_DIR=<private-artifact-directory>
# Integer > 180; default if omitted: 300
LEASE_SECONDS=<lease-duration-in-seconds>
